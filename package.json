{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@eli0shin/opencode-tree",
  "version": "2.0.1",
  "description": "Pi-style /tree plugin for OpenCode TUI.",
  "homepage": "https://github.com/eli0shin/opencode-tree#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eli0shin/opencode-tree.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "fmt": "oxfmt . '!dist/**'",
    "fmt:check": "oxfmt --check . '!dist/**'",
    "test:e2e:installed": "bash scripts/test-installed-tui.sh",
    "typecheck": "bun x tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.0",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/bun": "latest",
    "oxfmt": "^0.46.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "packageManager": "bun@1.3.8"
}
