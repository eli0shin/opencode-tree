{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@eli0shin/opencode-tree",
  "version": "2.0.0",
  "description": "Pi-style /tree plugin for OpenCode TUI.",
  "homepage": "https://github.com/eli0shin/opencode-tree#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eli0shin/opencode-tree.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "bun run scripts/build.ts",
    "typecheck": "bun x tsc -p tsconfig.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.0",
    "solid-js": "^1.9.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.0",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/bun": "latest",
    "oxfmt": "^0.46.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.8"
}
